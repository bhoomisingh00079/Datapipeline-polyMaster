# Local input. Copy the ZIP to data/raw/; raw data is excluded from Git.
DATASET_ZIP=data/raw/polygon_dataset.zip

# CA1 defaults to local output and requires no AWS account.
STORAGE_BACKEND=local
LOCAL_OUTPUT_DIR=data/processed

# Optional AWS S3 settings. Configure the named profile with AWS CLI on the Mac;
# Docker mounts ~/.aws read-only. Never put access keys in this file.
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=polygon-image-platform
AWS_PROFILE=

# Optional Docker Compose profiles. Keep these local-only values out of Git.
AIRFLOW_UID=50000
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_API_SECRET_KEY=
# For the full Docker profile, set this to spark://spark-master:7077.
SPARK_MASTER_URL=local[2]
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
